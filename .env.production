PORT = 3000
NODE_ENV = production

# Database (Production)
DB_HOST = prod-db.example.com
DB_PORT = 5432
DB_USERNAME = sophia_prod_user
DB_PASSWORD = ${DB_PASSWORD_PROD}
DB_DATABASE = sophia_central_prod

# Authentication
JWT_SECRET = ${JWT_SECRET_PROD}
JWT_EXPIRES_IN = 1h

# Redis (Production)
REDIS_HOST = prod-redis.example.com
REDIS_PORT = 6379
REDIS_PASSWORD = ${REDIS_PASSWORD_PROD}

APP_URL = https://api.sophia-central.com

# AWS S3 (Production)
AWS_REGION = us-east-1
AWS_ACCESS_KEY_ID = ${AWS_ACCESS_KEY_PROD}
AWS_SECRET_ACCESS_KEY = ${AWS_SECRET_KEY_PROD}
AWS_S3_BUCKET = sophia-central-prod

# AI Provider (Production)
AI_PROVIDER = openai
OPENAI_API_KEY = ${OPENAI_API_KEY_PROD}
OPENAI_MODEL = gpt-3.5-turbo
ANTHROPIC_API_KEY = ${ANTHROPIC_API_KEY_PROD}

# Monitoring (Production)
SENTRY_DSN = ${SENTRY_DSN_PROD}
