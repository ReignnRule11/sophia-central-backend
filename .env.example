# Example environment variables for Sophia Central (do NOT commit secrets)

# App & DB
DATABASE_URL=postgres://postgres:password@db:5432/sophia
REDIS_URL=redis://redis:6379
JWT_SECRET=your_jwt_secret
NODE_ENV=development

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sophia-dev-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ClamAV (optional HTTP wrapper or clamd TCP addr)
CLAMAV_DAEMON_ADDR=clamav:3310
CLAMAV_HTTP_SCAN_URL=

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-2
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
LLM_HOST=
LLM_API_KEY=

# AI provider priority (comma-separated)
AI_PROVIDER_PRIORITY=openai,anthropic,azure,llama
AI_PROVIDER_DEFAULT=openai
