PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sophia
DB_PASSWORD=replace-with-a-unique-local-password
DB_DATABASE=sophia_central
DB_SSL=false

# In production, use a cryptographically random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h

# Local development origins. On Render, set CORS_ORIGINS to the exact production
# frontend origin: https://sophiscentral.vercel.app (retain the previous origin
# temporarily during the cutover if the old hostname must remain usable).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Use "none" when frontend and API are on different sites; requires HTTPS in production.
AUTH_COOKIE_SAME_SITE=lax

# Password reset email delivery via Resend. Keep secrets in the hosting provider, not source control.
RESEND_TEMPLATE_ID=
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
# Local development URL. On Render, set this to https://sophiscentral.vercel.app.
FRONTEND_URL=http://localhost:5173

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

APP_URL=http://localhost:3000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=sophia-central
AWS_S3_BUCKET_URL=http://localhost:9000/sophia-central
AWS_S3_ENDPOINT=http://localhost:9000

# Gemini API credentials. Set the key only in your local environment or hosting provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini
