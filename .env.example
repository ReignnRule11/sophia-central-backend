PORT=3000
NODE_ENV=development

# Sentry error reporting. Set the DSN in your hosting provider; never commit the secret value.
SENTRY_DSN=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sophia
DB_PASSWORD=replace-with-a-unique-local-password
DB_DATABASE=sophia_central
DB_SSL=false

# In production, use a cryptographically random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h

# Required before initial Admin MFA enrollment. Generate a unique 32-byte key
# (64 hex characters) and store it only in the deployment environment.
ADMIN_MFA_ENCRYPTION_KEY=

# Local development origins. On Render, set CORS_ORIGINS to the exact production
# frontend origin: https://sophiscentral.vercel.app (retain the previous origin
# temporarily during the cutover if the old hostname must remain usable).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Use "none" when frontend and API are on different sites; requires HTTPS in production.
AUTH_COOKIE_SAME_SITE=lax

# Academic Reviewer recruitment is closed unless explicitly opened. The test-email
# allowlist permits only one verified reviewer registration while recruitment is closed.
# The Global Academic Reviewer email receives platform-wide academic scope after
# verified reviewer onboarding; this does not grant moderator or administrator access.
REVIEWER_RECRUITMENT_OPEN=false
REVIEWER_TEST_ACCOUNT_EMAIL=sophiscentral+reviewer@gmail.com
GLOBAL_ACADEMIC_REVIEWER_EMAIL=sophiscentral+reviewer@gmail.com

# Resend email delivery. Keep secrets in the hosting provider, not source control.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_FROM_EMAIL=
RESEND_TEMPLATE_ID=
RESEND_EMAIL_VERIFICATION_TEMPLATE_ID=
# Dedicated Sophis Central support mailbox and verified Resend sender identity.
# Set these only after the support domain/sender is verified in Resend.
SUPPORT_EMAIL=
SUPPORT_FROM_EMAIL=
# Local development URL. On Render, set this to https://sophiscentral.vercel.app.
FRONTEND_URL=http://localhost:5173

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

APP_URL=http://localhost:3000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=sophia-central
AWS_S3_BUCKET_URL=http://localhost:9000/sophia-central
AWS_S3_ENDPOINT=http://localhost:9000

# Groq is the primary AI provider. GPT-OSS 120B is the default model.
# Set the API key only in your local environment or hosting provider.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Conservative preflight input-token budget for AI prompts. Actual usage is
# recorded from each provider response; no user-facing Wisdom Points pricing changes.
SOPHIS_AI_MAX_INPUT_TOKENS=8000

# Gemini is retained as automatic fallback when Groq cannot generate a response.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Provider-neutral payments. Select paystack or flutterwave; never commit secret keys.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=
# Business-approved package map only. Example shape: {"starter":{"amountNaira":500,"points":40}}
# Keep empty until Wisdom Points package pricing is formally approved.
PAYMENT_WISDOM_PACKAGES={}
